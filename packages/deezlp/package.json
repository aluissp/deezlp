{
  "name": "deezlp",
  "version": "1.0.6",
  "author": "aluissp",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": "https://github.com/aluissp/deezlp.git",
  "homepage": "https://github.com/aluissp/deezlp/tree/main/packages/deezlp#deezlp",
  "keywords": [
    "deezlp",
    "mp3",
    "deezer",
    "download",
    "flac",
    "music"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "browser-id3-writer": "^6.3.1",
    "date-fns": "^4.4.0",
    "got": "^15.0.7",
    "metaflac-js2": "^1.0.8"
  },
  "devDependencies": {
    "deezer": "workspace:*",
    "tsup": "^8.5.1"
  }
}
