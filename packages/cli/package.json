{
  "name": "cli",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "main": "dist/main.cjs",
  "bin": {
    "deezlp": "dist/main.cjs"
  },
  "scripts": {
    "build": "tsup",
    "compile": "bunx pkg . --out-path out --no-bytecode"
  },
  "pkg": {
    "targets": [
      "node20-macos-x64",
      "node20-macos-arm64",
      "node20-linux-x64",
      "node20-linux-arm64",
      "node20-win-x64",
      "node20-win-arm64"
    ]
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/winston": "^2.4.4",
    "@yao-pkg/pkg": "^6.21.0",
    "deezer": "workspace:*",
    "deezlp": "workspace:*",
    "tsup": "^8.5.1"
  }
}
